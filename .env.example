# Flyero configuration template.
# Copy to .env and fill in real values. NEVER commit .env — only this example file.

# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
LOG_LEVEL=info                        # debug | info | warn | error

# Comma-separated bearer keys accepted by the REST API (see docs/API.md §1).
# Generate with: openssl rand -hex 24
API_KEYS=dev_key_change_me

# ── LLM providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Model roles (swappable without code changes):
LLM_PLANNER_MODEL=claude-opus-5       # brief, idea, composer, reviser
LLM_VISION_MODEL=claude-sonnet-5      # vision critic on rendered PNGs
LLM_CHEAP_MODEL=claude-haiku-4-5      # asset analysis, small classification passes

# ── Generation behavior (see docs/ARCHITECTURE.md) ────────────────────────
LINEAGES_PER_RUN=3                    # internal candidates per job (different metaphor families)
MAX_REVISION_LOOPS=3                  # critique→revise rounds per candidate
MAX_OUTER_RESTARTS=1                  # one fresh lineage set when every first-set candidate fails
DEFAULT_RISK=studio                   # safe | studio | experimental
JOB_TIMEOUT_SECONDS=240
MAX_VISION_CALLS_PER_JOB=10           # includes gate reviews, one restart, and final comparative jury

# ── Cost guards (see docs/API.md §6) ──────────────────────────────────────
MAX_CONCURRENT_JOBS=2                 # per API key
MAX_DAILY_USD=20                      # per API key, soft cap checked before jobs start
COST_ALERT_USD_PER_FLYER=1.50         # log a warning when a job exceeds this

# ── Storage ───────────────────────────────────────────────────────────────
DATABASE_PATH=./data/flyero.db        # SQLite in v1; DATABASE_URL takes over when Postgres lands
STORAGE_DIR=./data/objects            # renders, assets, specs, process logs
# DATABASE_URL=postgres://...         # unused until roadmap phase L6

# ── Rendering ─────────────────────────────────────────────────────────────
RENDER_ENGINE=resvg                   # resvg | playwright (fallback for complex filters)
RENDER_SCALE=2                        # PNG raster scale over 1080x1350 base
FONTS_DIR=./assets/fonts              # open-license TTF/OTF files registered with resvg
MAX_ASSET_BYTES=10485760              # 10 MB per stored asset, after downscaling
MAX_UPLOAD_BYTES=67108864             # 64 MB accepted on the wire; big photos are downscaled on ingest
ALLOWED_ASSET_MIME=image/png,image/jpeg,image/webp,image/svg+xml

# ── MCP server (docs/API.md §7) ───────────────────────────────────────────
MCP_TRANSPORT=stdio                   # stdio | http
FLYERO_API_URL=http://localhost:8080  # the MCP adapter calls the REST core here
FLYERO_API_KEY=dev_key_change_me      # key the MCP adapter uses

# ── Optional integrations ─────────────────────────────────────────────────
# WEBHOOK_SIGNING_SECRET=             # sign callbackUrl payloads when webhooks are used
PEXELS_API_KEY=